generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum Role { CUSTOMER TRANSPORTER ADMIN }
enum AccountStatus { ACTIVE SUSPENDED DELETED }
enum JobStatus { OPEN QUOTED BOOKED CANCELLED COMPLETED }
enum QuoteStatus { PENDING ACCEPTED DECLINED EXPIRED }
enum DateNegotiationStatus { ORIGINAL PROPOSED ACCEPTED DECLINED COUNTERED }
enum BookingStatus { CONFIRMED COLLECTION_SCHEDULED COLLECTED IN_TRANSIT ARRIVING_SOON DELIVERED CANCELLED }
enum EvidenceType { COLLECTION DELIVERY }
enum VerificationStatus { NOT_STARTED PENDING APPROVED REJECTED SUSPENDED }
enum VerificationDocumentType { INSURANCE COMPANY_REGISTRATION IDENTITY OPERATOR_LICENCE OTHER }
enum VerificationDocumentStatus { PENDING APPROVED REJECTED EXPIRED }

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  role Role
  passwordHash String
  accountStatus AccountStatus @default(ACTIVE)
  workRestricted Boolean @default(false)
  adminNote String?
  createdAt DateTime @default(now())
  sessions Session[]
  customerJobs TransportJob[] @relation("CustomerJobs")
  transporterQuotes Quote[] @relation("TransporterQuotes")
  customerBookings Booking[] @relation("CustomerBookings")
  transporterBookings Booking[] @relation("TransporterBookings")
  trackingEvents TrackingEvent[] @relation("TrackingActor")
  sentMessages Message[] @relation("MessageSender")
  uploadedEvidence Evidence[] @relation("EvidenceUploader")
  reviewsWritten Review[] @relation("ReviewCustomer")
  reviewsReceived Review[] @relation("ReviewTransporter")
  transporterVerification TransporterVerification?
  verificationDocuments VerificationDocument[] @relation("VerificationUploader")
  reviewedVerificationDocuments VerificationDocument[] @relation("DocumentReviewer")
  reviewedTransporterVerifications TransporterVerification[] @relation("VerificationAdminReviewer")
}

model TransportJob { id String @id @default(cuid()) customerId String customer User @relation("CustomerJobs",fields:[customerId],references:[id]) collection String delivery String vehicleMake String vehicleModel String registration String? running Boolean @default(true) collectionDate DateTime status JobStatus @default(OPEN) quotes Quote[] booking Booking? createdAt DateTime @default(now()) @@index([customerId,status,createdAt]) }
model Quote { id String @id @default(cuid()) jobId String job TransportJob @relation(fields:[jobId],references:[id]) transporterId String transporter User @relation("TransporterQuotes",fields:[transporterId],references:[id]) pricePence Int message String? proposedCollectionDate DateTime? dateNegotiationStatus DateNegotiationStatus @default(ORIGINAL) status QuoteStatus @default(PENDING) booking Booking? createdAt DateTime @default(now()) @@unique([jobId,transporterId]) @@index([transporterId,status,createdAt]) }
model Booking { id String @id @default(cuid()) jobId String @unique job TransportJob @relation(fields:[jobId],references:[id]) quoteId String @unique quote Quote @relation(fields:[quoteId],references:[id]) customerId String customer User @relation("CustomerBookings",fields:[customerId],references:[id]) transporterId String transporter User @relation("TransporterBookings",fields:[transporterId],references:[id]) agreedPricePence Int status BookingStatus @default(CONFIRMED) customerConfirmedAt DateTime? createdAt DateTime @default(now()) trackingEvents TrackingEvent[] messages Message[] evidence Evidence[] review Review? payment BookingPayment? @@index([customerId,status,createdAt]) @@index([transporterId,status,createdAt]) }
model TrackingEvent { id String @id @default(cuid()) bookingId String booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade) status BookingStatus note String? actorId String actor User @relation("TrackingActor",fields:[actorId],references:[id]) createdAt DateTime @default(now()) @@index([bookingId,createdAt]) }
model Message { id String @id @default(cuid()) bookingId String booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade) senderId String sender User @relation("MessageSender",fields:[senderId],references:[id]) body String createdAt DateTime @default(now()) @@index([bookingId,createdAt]) }
model Evidence { id String @id @default(cuid()) bookingId String booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade) uploaderId String uploader User @relation("EvidenceUploader",fields:[uploaderId],references:[id]) type EvidenceType imageUrl String note String? createdAt DateTime @default(now()) @@index([bookingId,type,createdAt]) }
model Review { id String @id @default(cuid()) bookingId String @unique booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade) customerId String customer User @relation("ReviewCustomer",fields:[customerId],references:[id]) transporterId String transporter User @relation("ReviewTransporter",fields:[transporterId],references:[id]) rating Int body String? verified Boolean @default(true) createdAt DateTime @default(now()) @@index([transporterId,createdAt]) }
model Session { id String @id @default(cuid()) tokenHash String @unique userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) expiresAt DateTime createdAt DateTime @default(now()) @@index([userId,expiresAt]) @@index([expiresAt]) }
model TransporterVerification { id String @id @default(cuid()) transporterId String @unique transporter User @relation(fields:[transporterId],references:[id],onDelete:Cascade) businessName String companyNumber String? businessAddress String phone String yearsOperating Int? website String? status VerificationStatus @default(NOT_STARTED) submittedAt DateTime? reviewedAt DateTime? reviewerId String? reviewer User? @relation("VerificationAdminReviewer",fields:[reviewerId],references:[id]) reviewNote String? documents VerificationDocument[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model VerificationDocument { id String @id @default(cuid()) verificationId String verification TransporterVerification @relation(fields:[verificationId],references:[id],onDelete:Cascade) uploaderId String uploader User @relation("VerificationUploader",fields:[uploaderId],references:[id]) type VerificationDocumentType documentUrl String policyNumber String? insurer String? expiresAt DateTime? status VerificationDocumentStatus @default(PENDING) reviewerId String? reviewer User? @relation("DocumentReviewer",fields:[reviewerId],references:[id]) reviewedAt DateTime? reviewNote String? createdAt DateTime @default(now()) @@index([verificationId,type]) @@index([expiresAt]) }
enum PaymentStatus { PENDING AUTHORIZED PAID PARTIALLY_REFUNDED REFUNDED FAILED CANCELLED }
enum PayoutStatus { NOT_READY READY PAID HELD CANCELLED }
enum FinanceEventType { PAYMENT_CREATED PAYMENT_CAPTURED REFUND_CREATED PAYOUT_READY PAYOUT_PAID }
model BookingPayment { id String @id @default(cuid()) bookingId String @unique booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade) currency String @default("GBP") transportValuePence Int depositPence Int platformFeePence Int transporterProceedsPence Int remainingBalancePence Int paidPence Int @default(0) refundedPence Int @default(0) status PaymentStatus @default(PENDING) payoutStatus PayoutStatus @default(NOT_READY) provider String @default("TEST") providerReference String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt events FinanceEvent[] }
model FinanceEvent { id String @id @default(cuid()) paymentId String payment BookingPayment @relation(fields:[paymentId],references:[id],onDelete:Cascade) type FinanceEventType amountPence Int? note String? actorId String? createdAt DateTime @default(now()) @@index([paymentId,createdAt]) }
